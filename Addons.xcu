<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Addons"
    oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <!-- Tools > Mermaid submenu -->
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="io.github.mermaidviewer.libreoffice" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergePoint" oor:type="xs:string">
            <value>.uno:ToolsMenu\.uno:MacrosMenu</value>
          </prop>
          <prop oor:name="MergeCommand" oor:type="xs:string">
            <value>AddBefore</value>
          </prop>
          <prop oor:name="MergeFallback" oor:type="xs:string">
            <value>AddPath</value>
          </prop>
          <prop oor:name="MergeContext" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.presentation.PresentationDocument</value>
          </prop>
          <node oor:name="MenuItems">
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="en-US">Mermaid</value>
              </prop>
              <prop oor:name="Context" oor:type="xs:string">
                <value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.presentation.PresentationDocument</value>
              </prop>
              <node oor:name="Submenu">
                <node oor:name="M01" oor:op="replace">
                  <prop oor:name="URL" oor:type="xs:string">
                    <value>vnd.io.github.mermaidviewer:InsertEdit</value>
                  </prop>
                  <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">Insert / Edit Diagram...</value>
                  </prop>
                  <prop oor:name="Target" oor:type="xs:string">
                    <value>_self</value>
                  </prop>
                </node>
                <node oor:name="M02" oor:op="replace">
                  <prop oor:name="URL" oor:type="xs:string">
                    <value>vnd.io.github.mermaidviewer:RefreshAll</value>
                  </prop>
                  <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">Re-render All Diagrams</value>
                  </prop>
                  <prop oor:name="Target" oor:type="xs:string">
                    <value>_self</value>
                  </prop>
                </node>
                <node oor:name="M02b" oor:op="replace">
                  <prop oor:name="URL" oor:type="xs:string">
                    <value>vnd.io.github.mermaidviewer:ConvertBlocks</value>
                  </prop>
                  <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">Render Mermaid Code in This Document</value>
                  </prop>
                  <prop oor:name="Target" oor:type="xs:string">
                    <value>_self</value>
                  </prop>
                  <prop oor:name="Context" oor:type="xs:string">
                    <value>com.sun.star.text.TextDocument</value>
                  </prop>
                </node>
                <node oor:name="M03" oor:op="replace">
                  <prop oor:name="URL" oor:type="xs:string">
                    <value>private:separator</value>
                  </prop>
                  <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US"/>
                  </prop>
                </node>
                <node oor:name="M04" oor:op="replace">
                  <prop oor:name="URL" oor:type="xs:string">
                    <value>vnd.io.github.mermaidviewer:Settings</value>
                  </prop>
                  <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">Settings...</value>
                  </prop>
                  <prop oor:name="Target" oor:type="xs:string">
                    <value>_self</value>
                  </prop>
                </node>
              </node>
            </node>
          </node>
        </node>
      </node>
    </node>

    <!-- Floating toolbar -->
    <node oor:name="OfficeToolBar">
      <node oor:name="io.github.mermaidviewer.libreoffice" oor:op="replace">
        <node oor:name="T01" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.io.github.mermaidviewer:InsertEdit</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Insert / Edit Mermaid Diagram</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
          <prop oor:name="Context" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.presentation.PresentationDocument</value>
          </prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string">
            <value>%origin%/icons/mermaid</value>
          </prop>
        </node>
        <node oor:name="T01b" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.io.github.mermaidviewer:ConvertBlocks</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Render Mermaid Code in This Document</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
          <prop oor:name="Context" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument</value>
          </prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string">
            <value>%origin%/icons/convert</value>
          </prop>
        </node>
        <node oor:name="T02" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.io.github.mermaidviewer:RefreshAll</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="en-US">Re-render All Mermaid Diagrams</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
          <prop oor:name="Context" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.presentation.PresentationDocument</value>
          </prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string">
            <value>%origin%/icons/refresh</value>
          </prop>
        </node>
      </node>
    </node>

    <node oor:name="Images">
      <node oor:name="io.github.mermaidviewer.libreoffice.img1" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>vnd.io.github.mermaidviewer:InsertEdit</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL">
            <value>%origin%/icons/mermaid_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL">
            <value>%origin%/icons/mermaid_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.mermaidviewer.libreoffice.img1b" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>vnd.io.github.mermaidviewer:ConvertBlocks</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL">
            <value>%origin%/icons/convert_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL">
            <value>%origin%/icons/convert_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="io.github.mermaidviewer.libreoffice.img2" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>vnd.io.github.mermaidviewer:RefreshAll</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL">
            <value>%origin%/icons/refresh_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL">
            <value>%origin%/icons/refresh_26.png</value>
          </prop>
        </node>
      </node>
    </node>

  </node>
</oor:component-data>
